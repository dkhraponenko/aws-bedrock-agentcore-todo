# The shape of the .env that scripts/sync_env.sh generates, with the account id
# blanked out. Committed so the variables are documented somewhere a fresh clone
# can see; .env itself is generated and gitignored.
#
# Do not fill this one in and rename it - run scripts/sync_env.sh, which reads
# the values out of terraform and cannot get them stale by hand.

AWS_REGION=us-east-1
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:000000000000:runtime/todo_agent_runtime-XXXXXXXXXX
GATEWAY_URL=https://todo-agent-gateway-xxxxxxxxxx.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp
DYNAMODB_TABLE_NAME=todo-agent-items

# Yours to edit; a regenerate keeps whatever is set here.
USER_ID=cli-operator
# The AWS profile to use when the shell exports none. Read by sync_env.sh,
# scripts/chat.py and the tests marked aws.
# AWS_PROFILE=my-profile
