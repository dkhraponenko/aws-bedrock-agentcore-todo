# Copy to terraform.tfvars (git-ignored) to override the model without
# touching variables.tf. Terraform loads terraform.tfvars automatically.
#
# The default in variables.tf is Claude Sonnet 5. Anthropic models require a
# one-time use-case form plus a per-model agreement before the first call
# succeeds; check with:
#
#   aws bedrock get-foundation-model-availability \
#     --model-id anthropic.claude-sonnet-5 --region us-east-1
#
# Amazon Nova needs neither, which makes it a convenient model to deploy
# against while that access is pending.

agent_model      = "us.amazon.nova-pro-v1:0"
agent_base_model = "amazon.nova-pro-v1:0"
